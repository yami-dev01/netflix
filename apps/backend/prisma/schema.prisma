

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User { 
  id        Int     @id @default(autoincrement()) 
  userName  String?
  password  String
  wishList  wishlist[]
} 

model wishlist {
  id        Int       @id @default(autoincrement()) 
  movieId   Int
  userId    Int
  user      User      @relation(fields: [userId] , references: [id] , onDelete: Cascade)
}